# ===========================================
# KFC E-commerce — Environment Variables
# Copy this file to .env (root, used by docker-compose)
# and adjust backend/.env + frontend/.env if running services individually.
# ===========================================

# --- Postgres ---
POSTGRES_USER=kfc
POSTGRES_PASSWORD=kfc_password
POSTGRES_DB=kfc_ecommerce
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql://kfc:kfc_password@postgres:5432/kfc_ecommerce?schema=public
JWT_SECRET=super_secret_jwt_change_me_in_production
JWT_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_test_51_replace_with_your_stripe_test_secret_key
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key
REDIS_URL=redis://redis:6379
PORT=5000
NODE_ENV=development

# --- Frontend ---
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLIC_KEY=pk_test_51_replace_with_your_stripe_test_public_key
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key
